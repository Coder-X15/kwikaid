SUPABASE_URL=https://qbrktjyqdejvjwrwohvd.supabase.co
# The service_role (secret) key, not the anon key. Never commit the real one.
SUPABASE_KEY=<service_role key>

# Optional (defaults shown)
# Bucket the app uploads photos to. If unset, it's read from each row's storage_url.
# SUPABASE_BUCKET=
# POLL_INTERVAL_SECONDS=5
# Port for GET /health. On a Mac pick another one: AirPlay Receiver holds 5000.
# PORT=5000
# LOG_LEVEL=INFO
